---
import { Image } from 'astro:assets';
import { contentPath, withBase } from '../../lib/urls';
import type { ContentItem } from '../../lib/content-repository';
import type { Lang } from '../../lib/types';

const { lang, item } = Astro.props as { lang: Lang; item: ContentItem };
const href = withBase(contentPath(lang, item.data.slug));
const cover = item.data.cover;
// 副标题未填写时回退到 description。回退只此一行，不额外抽模块。
const subtitle = item.data.subtitle ?? item.data.description;
---
<a class:list={['project-card', !cover && 'project-card--bare']} href={href}>
  {cover && <Image class="project-card__cover" src={cover} alt="" loading="lazy" />}
  <div class="project-card__meta">
    <h3 class="project-card__title">{item.data.title}</h3>
    <p class="project-card__subtitle">{subtitle}</p>
  </div>
</a>
