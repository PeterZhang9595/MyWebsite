---
import { render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import DirectoryIndex from '../content/DirectoryIndex.astro';
import ArticleMeta from '../content/ArticleMeta.astro';
import { directChildren, findTranslatedItem, loadPublicContent, type ContentItem } from '../../lib/content-repository';
import { contentSegments } from '../../lib/content-navigation';
import { contentPath, withBase } from '../../lib/urls';
import { sectionPath } from '../../i18n';
import { buildAlternates } from '../../lib/seo';
import type { Lang, Section } from '../../lib/types';
const { lang, section, item } = Astro.props as { lang: Lang; section: Section; item: ContentItem };
const other = lang === 'zh' ? 'en' : 'zh';
const translation = await findTranslatedItem(item,section,other);
const languageHref = translation ? contentPath(other,translation.data.slug) : sectionPath(other,section);
const alternates = translation ? buildAlternates(lang === 'zh' ? contentPath(lang,item.data.slug) : contentPath(other,translation.data.slug), lang === 'en' ? contentPath(lang,item.data.slug) : contentPath(other,translation.data.slug)) : [];
const path = contentPath(lang,item.data.slug);
const parentSlug = item.data.slug.split('/').slice(0,-1).join('/');
const parentHref = withBase(parentSlug === section ? sectionPath(lang,section) : contentPath(lang,parentSlug));
const Content = (await render(item.entry)).Content;
const children = item.isDirectory ? directChildren(await loadPublicContent(section,lang),item.data.slug) : null;
---
<ContentLayout {lang} title={item.data.title} description={item.data.description} {languageHref} canonicalPath={path} {alternates} segments={contentSegments(lang,section,item.data.slug,item.data.title)} {parentHref} searchable={!item.isDirectory} article={!item.isDirectory} dates={item.dates}>
  {section === 'projects' && <div class="project-facts" data-pagefind-ignore><span>{item.data.status}</span>{item.data.technologies?.length && <span>{item.data.technologies.join(' · ')}</span>}{item.data.repositoryUrl && <a href={item.data.repositoryUrl}>Repository ↗</a>}{item.data.demoUrl && <a href={item.data.demoUrl}>Demo ↗</a>}</div>}
  {!item.isDirectory && <ArticleMeta dates={item.dates} {lang}/>}
  <div class="prose"><Content/></div>
  {children && <DirectoryIndex {lang} {...children}/>}
</ContentLayout>
