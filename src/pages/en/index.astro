---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeLayout from '../../layouts/HomeLayout.astro';
import TerminalPath from '../../components/navigation/TerminalPath.astro';
import ProfileHeader from '../../components/home/ProfileHeader.astro';
import BioToggle from '../../components/home/BioToggle.astro';
import SectionEntry from '../../components/home/SectionEntry.astro';
import PersonalMedia from '../../components/media/PersonalMedia.astro';
import { loadRecentFocus } from '../../lib/local-data';
import { contentPath, localDataHref, withBase } from '../../lib/urls';
import { ui } from '../../i18n';
import { siteConfig } from '../../site.config';
import { buildAlternates } from '../../lib/seo';

const lang = 'en' as const;
const bios = (await getCollection('bioEn')).filter((entry) => !entry.data.draft);
const defaultBio = bios.find((entry) => entry.data.variant === 'default');
const longBio = bios.find((entry) => entry.data.variant === 'long');
const DefaultBio = defaultBio ? (await render(defaultBio)).Content : null;
const LongBio = longBio ? (await render(longBio)).Content : null;
const tips = (await getCollection('tipsEn')).filter((entry) => !entry.data.draft).sort((a,b) => a.data.order-b.data.order);
const focus = loadRecentFocus().sort((a,b) => a.order-b.order);
---
<BaseLayout lang={lang} languageHref="/" alternates={buildAlternates('/','/en/')}>
  <HomeLayout>
    <TerminalPath segments={[{ label: '/root' }]} />
    <ProfileHeader />
    <BioToggle lang={lang} hasDefault={Boolean(DefaultBio)} hasLong={Boolean(LongBio)}>
      {DefaultBio && <DefaultBio slot="default" />}
      {LongBio && <LongBio slot="long" />}
    </BioToggle>
    <div class="split-index">
      <section><h2>{ui(lang,'recentFocus')}</h2>{focus.length ? <ul class="index-list">{focus.map((item) => <li>{item.url ? <a href={localDataHref(item.url)}>{item.title[lang]}</a> : item.title[lang]}</li>)}</ul> : <p>{ui(lang,'empty')}</p>}</section>
      <section><h2>{ui(lang,'tips')}</h2>{tips.length ? <ul class="index-list">{tips.map((tip) => <li><a href={withBase(contentPath(lang,tip.data.slug))}>{tip.data.title}</a></li>)}</ul> : <p>{ui(lang,'empty')}</p>}</section>
    </div>
    <nav aria-label="Main sections">
      <SectionEntry href={withBase('/en/notes/')} title={ui(lang,'notes')} description="Study notes, technical derivations, and a growing learning archive." action="Enter →" />
      <SectionEntry href={withBase('/en/projects/')} title={ui(lang,'projects')} description="Long-running projects, experiments, and open-source work." action="Enter →" />
      <SectionEntry href={withBase('/en/interests/')} title={ui(lang,'interests')} description="Music, games, and interests beyond work." action="Enter →" />
    </nav>
    <footer class="copyright">© {new Date().getFullYear()} {siteConfig.copyrightOwner}</footer>
    <PersonalMedia slot="aside" lang={lang} />
  </HomeLayout>
</BaseLayout>
