---
import ContentItemPage from '../../../components/pages/ContentItemPage.astro';
import { loadPublicContent } from '../../../lib/content-repository';
export async function getStaticPaths(){return (await loadPublicContent('tips','en')).filter((item)=>item.data.slug!=='tips').map((item)=>({params:{slug:item.data.slug.slice('tips/'.length)},props:{item}}));}
const { item } = Astro.props;
---
<ContentItemPage lang="en" section="tips" {item}/>
